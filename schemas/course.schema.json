{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conceptloom.dev/schemas/course.schema.json",
  "title": "ConceptLoom Course",
  "type": "object",
  "required": ["schemaVersion", "uid", "revision", "status", "topic", "goal", "lessons", "sourceUids", "approvals", "progression"],
  "properties": {
    "schemaVersion": { "const": 1 }, "uid": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["diagnosing", "researching", "roadmap-draft", "approved", "active", "paused", "completed", "blocked"] },
    "topic": { "type": "string", "minLength": 1 }, "goal": { "type": "string", "minLength": 1 },
    "diagnostic": { "type": "object" }, "roadmapRevision": { "type": ["string", "null"] },
    "lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } },
    "sourceUids": { "type": "array", "items": { "type": "string" } },
    "approvals": { "type": "array", "items": { "type": "object" } },
    "scheduleBinding": { "type": "object" }, "progression": { "type": "object" }
  },
  "$defs": { "lesson": { "type": "object", "required": ["uid", "title", "objectives", "conceptUids", "prerequisiteLessonUids", "sourceBindings", "exerciseUids", "estimatedMinutes", "status"] } },
  "additionalProperties": true
}

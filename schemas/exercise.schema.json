{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConceptLoom public exercise",
  "type": "object",
  "required": ["schemaVersion", "uid", "lessonUid", "kind", "revision", "publicSpec"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "uid": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" },
    "lessonUid": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" },
    "kind": { "enum": ["scenario", "simulation", "coding"] },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "publicSpec": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
